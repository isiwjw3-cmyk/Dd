-- ตัวแปรเก็บสถานะฟังก์ชัน และค่า HoldDuration เดิมของแต่ละ Prompt
local isEnabled = false
local originalDurations = {}

-- ฟังก์ชันปรับแต่ง ProximityPrompt
local function applyPrompt(prompt)
    if isEnabled then
        if not originalDurations[prompt] then
            originalDurations[prompt] = prompt.HoldDuration
        end
        prompt.HoldDuration = 0
    end
end

-- ตรวจสอบ Prompt ที่มีอยู่เดิมและที่จะถูกสร้างขึ้นใหม่
local function setupPrompts()
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            applyPrompt(prompt)
        end
    end
end

-- ตรวจสอบเวลาเกมเพิ่ม Prompt ใหม่เข้ามาเรื่อยๆ
workspace.DescendantAdded:Connect(function(descendant)
    if isEnabled and descendant:IsA("ProximityPrompt") then
        task.wait(0.1)
        applyPrompt(descendant)
    end
end)

-- ทำงานเมื่อมีการเปิด Prompt โดยระบบเกม (ดักจับเพื่อปรับเวลาแบบเรียลไทม์)
ProximityPromptService.PromptShown:Connect(function(prompt)
    if isEnabled then
        if not originalDurations[prompt] then
            originalDurations[prompt] = prompt.HoldDuration
        end
        prompt.HoldDuration = 0
    end
end)

-- การทำงานของปุ่ม Toggle
toggleBtn.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    
    if isEnabled then
        -- เปิดฟังก์ชัน (เปลี่ยนเป็นสีเขียว)
        TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 180, 80)}):Play()
        toggleBtn.Text = "หยิบไข่ไว: ON"
        setupPrompts()
    else
        -- ปิดฟังก์ชัน (คืนค่ากลับเป็นสีแดง)
        TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(180, 50, 50)}):Play()
        toggleBtn.Text = "หยิบไข่ไว: OFF"
        
        -- คืนค่า HoldDuration เดิมให้ทุก Prompt
        for prompt, originalTime in pairs(originalDurations) do
            if prompt and prompt.Parent then
                prompt.HoldDuration = originalTime
            end
        end
        table.clear(originalDurations)
    end
end)
